# --- AI providers -------------------------------------------------------------
# auto = OpenAI first, fall back to Gemini | openai | gemini
AI_PROVIDER=auto
# Required when AI_PROVIDER is auto or openai. Needs a funded OpenAI API account.
OPENAI_API_KEY=
# Required when AI_PROVIDER is auto or gemini. Create a key in Google AI Studio.
GEMINI_API_KEY=
# Optional model overrides (useful if your account cannot access a default).
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_COACH_MODEL=gpt-4.1
GEMINI_MODEL=gemini-2.5-flash
# --- Optional flight search: Amadeus Self-Service -----------------------------
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test or production. Test offers are synthetic / limited.
AMADEUS_ENV=test
PORT=3000
