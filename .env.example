# Required for transcription and live coaching
OPENAI_API_KEY=
# Strong coaching model; choose a smaller model if you prefer lower cost/latency.
OPENAI_COACH_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional: Amadeus Self-Service credentials for indicative flight offers
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test or production. Test offers are synthetic / limited.
AMADEUS_ENV=test
PORT=3000
